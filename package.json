{
  "name": "arg-parser",
  "version": "1.0.0",
  "description": "TypeScript command-line argument parsing with nested commands and usage generation",
  "repository": {
    "type": "git",
    "url": "https://github.com/argeeee/arg-parser.git"
  },
  "homepage": "https://github.com/argeeee/arg-parser#readme",
  "bugs": {
    "url": "https://github.com/argeeee/arg-parser/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./args": {
      "types": "./dist/args.d.ts",
      "require": "./dist/args.js",
      "default": "./dist/args.js"
    },
    "./command_runner": {
      "types": "./dist/command_runner.d.ts",
      "require": "./dist/command_runner.js",
      "default": "./dist/command_runner.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:package": "npm run build && node test/package-smoke.mjs",
    "check:example": "npm run build && tsc -p tsconfig.example.json && node .example-dist/examples/basic.js"
  },
  "keywords": ["cli", "arguments", "parser", "command-line"],
  "author": "Argetim Jusufi",
  "license": "BSD-3-Clause",
  "type": "commonjs",
  "engines": { "node": ">=18" },
  "files": ["dist", "README.md", "LICENSE"],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
